# ===========================================================================
# Production .env template for api.exquillermember.com
# ---------------------------------------------------------------------------
# Copy this file to `.env` on the production server and fill every
# `<FILL_ME>` marker. Do NOT commit the filled copy — `.env` is gitignored.
# After editing, run: php artisan config:cache && php artisan queue:restart
# ===========================================================================

APP_NAME="Exquiller Member"
APP_ENV=production
APP_KEY=<FILL_ME_run_php_artisan_key_generate_on_server>
APP_DEBUG=false
APP_URL=https://api.exquillermember.com

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_db
DB_USERNAME=<FILL_ME>
DB_PASSWORD=<FILL_ME>

# Sessions — use database so server restart does not kill admin sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.exquillermember.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Sanctum — allow cookie-based auth from the Flutter web front-end
SANCTUM_STATEFUL_DOMAINS=exquillermember.com,www.exquillermember.com
SANCTUM_EXPIRATION=43200  # 30 days in minutes

# Mail (optional — fill if you actually send mail)
MAIL_MAILER=log

# PaySolutions — LIVE credentials
PAYSOLUTIONS_TEST_MODE=false
PAYSOLUTIONS_API_KEY=<FILL_ME>
PAYSOLUTIONS_SECRET_KEY=<FILL_ME>
PAYSOLUTIONS_MERCHANT_ID=<FILL_ME>
PAYSOLUTIONS_API_URL=https://apis.paysolutions.asia
PAYSOLUTIONS_PAYMENT_URL=https://www.thaiepay.com/epaylink/payment.aspx
PAYSOLUTIONS_CALLBACK_URL=https://api.exquillermember.com/api/payment/callback
PAYSOLUTIONS_RETURN_URL=https://exquillermember.com/payment/success
PAYSOLUTIONS_CANCEL_URL=https://exquillermember.com/payment/cancel
PAYSOLUTIONS_CURRENCY=THB
PAYSOLUTIONS_LANGUAGE=TH
PAYSOLUTIONS_TIMEOUT=30

# Telegram notifications
TELEGRAM_BOT_TOKEN=<FILL_ME>
TELEGRAM_CHAT_ID=<FILL_ME>

VITE_APP_NAME="${APP_NAME}"
